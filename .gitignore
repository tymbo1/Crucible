# Raw corpora and packed datasets
*.bin
*.txt
*.pt
*.pth
*.safetensors
*.tar
*.tar.gz

# Content-addressed frozen workspace artifacts are reproducibility dependencies.
# Keep ordinary training checkpoints ignored, but allow these small immutable
# dependency bundles to be versioned and pushed with their metadata.
!experiments/**/workspace_artifacts/
!experiments/**/workspace_artifacts/**/
!experiments/**/workspace_artifacts/**/state.pt

# Python/build caches
__pycache__/
*.py[cod]
.pytest_cache/

# Local credentials and environment files
.env
.env.*
*api_key*
*secret*
*.pem

# Large generated traces; retain summaries and hashes instead
*trace*.jsonl
*batch_trace*.jsonl
